	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"@clack/prompts": "^0.10.0",
		"@raydium-io/raydium-sdk-v2": "^0.1.111-alpha",
		"@solana/buffer-layout": "^4.0.1",
		"@solana/spl-token": "^0.4.12",
		"@solana/web3.js": "^1.98.0",
		"@upstash/redis": "^1.34.4",
		"bignumber.js": "^9.1.2",
		"bn.js": "^5.2.1",
		"bs58": "^6.0.0",
		"decimal.js": "^10.5.0",
		"helius-sdk": "^1.4.2",
		"neverthrow": "^8.1.1",

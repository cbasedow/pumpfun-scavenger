{
	"name": "pumpfun-scavenger",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"typecheck": "tsc --noEmit",
		"format": "bunx biome format --write .",
		"lint": "bunx biome lint --error-on-warnings ",
		"check": "bunx biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/bn.js": "^5.1.6",
